{
  // Cloudflare Worker config for shortutorial.com
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shortutorial",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shortutorial-db",
      "database_id": "5dfb6a95-6814-4d91-9a4f-ae967d4577db"
    }
  ],
  // Workers AI powers the smart (meaning-based) search.
  "ai": { "binding": "AI" },
  // Rebuild the search catalog from public/tutorials.js before every deploy.
  "build": { "command": "node scripts/build-catalog.mjs" },
  "observability": { "enabled": true }
}
